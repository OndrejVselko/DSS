<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GUI.CreateVaccineStepView">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="400">
        <TextBlock Text="Vytvoření vakcíny" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Text="Účinnost ochrany před nákazou (%)"/>
        <TextBox x:Name="ProtectionBox" TextChanged="OnPercentDoubleTextChanged"/>
        <TextBlock Text="Pravděpodobnost, že vakcína ochrání očkovaného před nákazou."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

        <TextBlock Text="Účinnost ochrany před smrtí (%)"/>
        <TextBox x:Name="DeathProtectionBox" TextChanged="OnPercentDoubleTextChanged"/>
        <TextBlock Text="Pravděpodobnost, že vakcína ochrání očkovaného před smrtí."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

        <TextBlock Text="Vakcína bude dostupná všem regionům. Očkování je nutné spustit v průběhu simulace."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
