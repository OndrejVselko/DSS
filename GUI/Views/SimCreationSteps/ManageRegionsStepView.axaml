<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GUI.ManageRegionsStepView">
  <Grid ColumnDefinitions="250, *" Margin="20">
        
        <!-- Seznam regionů -->
        <ListBox x:Name="RegionListBox" 
                 Grid.Column="0"
                 SelectionChanged="OnRegionSelectionChanged"/>

        <!-- Detail regionu -->
        <Grid Grid.Column="1" Margin="20,0,0,0" RowDefinitions="Auto, Auto, *, Auto">
            
            <!-- Název regionu -->
            <TextBlock x:Name="RegionNameText" 
                       Grid.Row="0"
                       Text="Vyberte region"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Populace a Healthcare Index -->
            <Grid Grid.Row="1" ColumnDefinitions="*, 40, *, 40, Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Populace"/>
                    <TextBox x:Name="PopulationBox" TextChanged="OnIntTextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Index zdravotnictví"/>
                    <TextBox x:Name="HealthcareBox" TextChanged="OnDoubleTextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Bottom">
                <CheckBox x:Name="InfectedCheckBox" Content="Nakažený" IsCheckedChanged="OnInfectedChanged"/>                </StackPanel>
            </Grid>

            <!-- Ability -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto, *">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Aktivní vlastnosti" FontWeight="Bold"/>
                    <ListBox x:Name="ActiveAbilitiesBox" Height="300"
                             SelectionChanged="OnAbilitySelectionChanged"
                             DoubleTapped="OnActiveAbilityDoubleTapped"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↔"
                        VerticalAlignment="Center" Margin="8,0"
                        Click="OnMoveAbilityClicked"/>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Dostupné vlastnosti" FontWeight="Bold"/>
                    <ListBox x:Name="AvailableAbilitiesBox" Height="300"
                             SelectionChanged="OnAbilitySelectionChanged"
                             DoubleTapped="OnAvailableAbilityDoubleTapped"/>
                </StackPanel>
            </Grid>

            <!-- Popis ability -->
            <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1"
                    Padding="8" Height="150" Margin="0,12,0,0">
                <TextBlock x:Name="AbilityDescriptionText"
                           Text="Vyberte vlastnost pro zobrazení popisu."
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
