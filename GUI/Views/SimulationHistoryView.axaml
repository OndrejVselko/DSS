<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GUI.Views.SimulationHistoryView">
    <Grid ColumnDefinitions="300, *" Margin="16">
        
        <!-- Levý panel - seznam simulací -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto">
            <ListBox Grid.Row="0" x:Name="SimulationListBox"
                     SelectionChanged="OnSimulationSelected"/>
            <Button Grid.Row="1" Content="Zpět" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnBackClicked"/>
        </Grid>

        <!-- Pravý panel - detail -->
        <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="0.3*, 0.7*">
            
            <!-- Info o simulaci -->
            <StackPanel Grid.Row="0" Spacing="4" x:Name="DetailPanel" IsVisible="False">
                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="DetailDate"/>
                <TextBlock x:Name="DetailSpeed"/>
                <TextBlock x:Name="DetailDeath"/>
                <TextBlock x:Name="DetailSickness"/>
                <TextBlock x:Name="DetailImmunity"/>
            </StackPanel>

            <!-- Log -->
            <TextBox Grid.Row="1" x:Name="LogTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</UserControl>