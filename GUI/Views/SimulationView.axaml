<?xml version="1.0" encoding="utf-8"?>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="GUI.Views.SimulationView">
    <Design.DataContext>
        </Design.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1000"/>     <ColumnDefinition Width="600"/>       </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="600"/>          <RowDefinition Height="300"/>        </Grid.RowDefinitions>
        
        <mapsui:MapControl Grid.Column="0" Grid.Row="0" x:Name="MapControl"/>
        
        <Border Grid.Column="0" Grid.Row="1" Background="LightGray" BorderBrush="Black" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, Auto, 1*, Auto, 1*, 1.5*">
                
                <Button Grid.Column="0" Content="🌍" VerticalAlignment="Top" Margin="8"
                        Click="OnClearRegionClicked"/>

                <StackPanel Grid.Column="1" Spacing="12" Margin="8" Width="220">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RegionNameLabel" FontSize="16" FontWeight="Bold" Text="Celý svět"/>
                        <TextBlock x:Name="PopulationLabel" Text="Populace: -"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nakažení:"/>
                            <TextBlock x:Name="SickLabel" Text="-"/>
                            <TextBlock x:Name="SickDeltaLabel" Text="(0)" Foreground="Gray"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Mrtví:"/>
                            <TextBlock x:Name="DeadLabel" Text="-"/>
                            <TextBlock x:Name="DeadDeltaLabel" Text="(0)" Foreground="Gray"/>
                        </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Očkovaní:"/>
                    <TextBlock x:Name="VaccinatedLabel" Text="-"/>
                    <TextBlock x:Name="VaccinatedDeltaLabel" Text="(0)" Foreground="Gray"/>
                </StackPanel>
                <CheckBox x:Name="VaccinatingCheckBox" Content="Očkuje" 
                          IsCheckedChanged="OnVaccinatingChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="4" x:Name="RegionDetailsPanel" IsVisible="False">
                        <TextBlock x:Name="SpreadingLabel" Text="Šíření: - / -"/>
                        <TextBlock x:Name="RandomOccurrenceLabel" Text="Náhodný výskyt: -"/>
                        <TextBlock x:Name="DeathLabel" Text="Úmrtnost: - / -"/>
    
                        <TextBlock Text="Index zdravotnictví:" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="HealthcareIndexBox" Width="80" TextChanged="OnPositiveDoubleTextChanged"/>
                            <Button Content="✓" Click="OnHealthcareConfirmed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="ActiveAbilitiesRegionPanel" Grid.Column="2" RowDefinitions="Auto, *" Margin="8">
                    <TextBlock Grid.Row="0" Text="Aktivní vlastnosti" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="1" x:Name="ActiveAbilitiesRegionBox"
                             SelectionChanged="OnAbilitySelectionRegionChanged"
                             DoubleTapped="OnActiveAbilityRegionDoubleTapped"/>
                </Grid>

                <Button Grid.Column="3" x:Name="MoveAbilityRegionButton" Content="↔"
                        VerticalAlignment="Center" Margin="4,0"
                        Click="OnMoveAbilityRegionClicked"/>

                <Grid x:Name="AvailableAbilitiesRegionPanel" Grid.Column="4" RowDefinitions="Auto, *" Margin="8">
                    <TextBlock Grid.Row="0" Text="Dostupné vlastnosti" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="1" x:Name="AvailableAbilitiesRegionBox"
                             SelectionChanged="OnAbilitySelectionRegionChanged"
                             DoubleTapped="OnAvailableAbilityRegionDoubleTapped"/>
                </Grid>

                <Grid x:Name="AbilityDescriptionPanel" Grid.Column="5" RowDefinitions="Auto, *" Margin="8">
                    <TextBlock Grid.Row="0" Text="Detail vlastnosti" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#EAEAEA" CornerRadius="3" Padding="8">
                        <ScrollViewer>
                            <TextBlock x:Name="AbilityDescriptionText"
                                       Text="Vyberte vlastnost pro zobrazení popisu."
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </Border>
        
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="LightGray" BorderBrush="Black" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="8" Spacing="8">

                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto">
                        <Button x:Name="PlayPauseButton" Grid.Column="0" 
                                Content="▶" Width="40" Height="40"
                                Click="OnPlayPauseClicked"/>
                        <TextBlock x:Name="DateText" Grid.Column="1" 
                                   VerticalAlignment="Center" Margin="8,0"
                                   Text="--.--.----"/>
                        <TextBlock Grid.Column="2" Text="Rychlost dne:" 
                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                   HorizontalAlignment="Right"/>
                        <TextBox x:Name="DaySpeedBox" Grid.Column="3" Width="80" 
                                 VerticalAlignment="Center" TextChanged="OnDaySpeedTextChanged"/>
                        <Button Grid.Column="4" Content="✓" Margin="4,0,0,0"
                                VerticalAlignment="Center" Click="OnDaySpeedConfirmed"/>
                        <Button Grid.Column="5" Content="📸" Margin="4,0,0,0"
                                VerticalAlignment="Center" Click="OnScreenshotClicked"/>
                    </Grid>

                    <Separator/>

                    <TextBlock x:Name="DiseaseNameText" FontWeight="Bold" Text=""/>

                   <Grid ColumnDefinitions="*, *">
                        <!-- Levá polovina -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="Nastavení nemoci" FontWeight="Bold"/>
    
                            <TextBlock Text="Rychlost šíření" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Základ:" VerticalAlignment="Center" Width="50"/>
                                <TextBox x:Name="SpreadingSpeedBox" Width="80" TextChanged="OnPositiveDoubleTextChanged"/>
                                <Button Content="✓" Click="OnSpreadingSpeedConfirmed"/>
                                <TextBlock x:Name="TotalSpreadingText" VerticalAlignment="Center" Text="Celkem: -"/>
                            </StackPanel>

                            <TextBlock Text="Šance na úmrtí" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Základ:" VerticalAlignment="Center" Width="50"/>
                                <TextBox x:Name="DeathBox" Width="80" TextChanged="OnPercentDoubleTextChanged"/>
                                <Button Content="✓" Click="OnDeathConfirmed"/>
                                <TextBlock x:Name="TotalDeathText" VerticalAlignment="Center" Text="Celkem: -"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Pravá polovina -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="Nastavení vakcíny" FontWeight="Bold"/>
    
                            <TextBlock Text="Účinnost proti přenosu (%):" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox x:Name="VaccineProtectionBox" Width="80" TextChanged="OnPercentDoubleTextChanged"/>
                                <Button Content="✓" Click="OnVaccineConfirmed"/>
                            </StackPanel>
    
                            <TextBlock Text="Účinnost proti úmrtí (%):" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox x:Name="VaccineDeathBox" Width="80" TextChanged="OnPercentDoubleTextChanged"/>
                                <Button Content="✓" Click="OnVaccineConfirmed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Separator/>

                    <TextBlock Text="Vlastnosti nemoci" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*, Auto, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Aktivní" FontSize="11"/>
                            <ListBox x:Name="ActiveDiseaseAbilitiesBox" Height="150"
                                     SelectionChanged="OnDiseaseAbilitySelectionChanged"
                                     DoubleTapped="OnActiveDiseaseAbilityDoubleTapped"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="↔" VerticalAlignment="Center" 
                                Margin="4,0" Click="OnMoveDiseaseAbilityClicked"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dostupné" FontSize="11"/>
                            <ListBox x:Name="AvailableDiseaseAbilitiesBox" Height="150"
                                     SelectionChanged="OnDiseaseAbilitySelectionChanged"
                                     DoubleTapped="OnAvailableDiseaseAbilityDoubleTapped"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="4" Height="100">
                        <TextBlock x:Name="DiseaseAbilityDescText" TextWrapping="Wrap" FontSize="11"/>
                    </Border>

                    <Separator/>

                   

                    <TextBlock Text="Denní výpis" FontWeight="Bold"/>
                    <ListBox x:Name="LogBox" Height="200"/>

                    <Separator/>

                    <Button Content="Ukončit simulaci" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnStopSimulationClicked"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>