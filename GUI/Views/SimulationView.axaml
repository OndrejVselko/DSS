<?xml version="1.0" encoding="utf-8"?>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="GUI.Views.SimulationView">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
  </Design.DataContext>
      <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1000"/>        <!-- mapa, zbyde místo -->
            <ColumnDefinition Width="600"/>      <!-- pravý panel, fixní -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="600"/>          <!-- mapa -->
            <RowDefinition Height="300"/>        <!-- spodní panel, fixní -->
        </Grid.RowDefinitions>
        <!-- Mapa -->
<mapsui:MapControl Grid.Column="0" Grid.Row="0" x:Name="MapControl"/>
        <!-- Spodní panel - region info -->
        <Border Grid.Column="0" Grid.Row="1" Background="LightGray" BorderBrush="Black" BorderThickness="0,1,0,0"/>
        <!-- Pravý panel - ovládání -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="LightGray" BorderBrush="Black" BorderThickness="1,0,0,0">
        <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
    <StackPanel Margin="8" Spacing="8">

        <!-- Řádek 1: Play/Pause, datum, název nemoci -->
        <Grid ColumnDefinitions="Auto, *, *">
            <Button x:Name="PlayPauseButton" Grid.Column="0" 
                    Content="▶" Width="40" Height="40"
                    Click="OnPlayPauseClicked"/>
            <TextBlock x:Name="DateText" Grid.Column="1" 
                       VerticalAlignment="Center" Margin="8,0"
                       Text="--.--.----"/>
            <TextBlock x:Name="DiseaseNameText" Grid.Column="2"
                       VerticalAlignment="Center"
                       Text=""/>
        </Grid>

        <Separator/>

        <!-- Rychlost šíření -->
        <TextBlock Text="Rychlost šíření" FontWeight="Bold"/>
        <Grid ColumnDefinitions="Auto, *, Auto, *">
            <TextBlock Grid.Column="0" Text="Základ:" VerticalAlignment="Center"/>
            <TextBox x:Name="SpreadingSpeedBox" Grid.Column="1" Margin="4,0"/>
            <Button Grid.Column="2" Content="✓" Margin="4,0"
                    Click="OnSpreadingSpeedConfirmed"/>
            <TextBlock x:Name="TotalSpreadingText" Grid.Column="3" 
                       VerticalAlignment="Center" Text="Celkem: -"/>
        </Grid>

        <!-- Úmrtnost -->
        <TextBlock Text="Šance na úmrtí" FontWeight="Bold"/>
        <Grid ColumnDefinitions="Auto, *, Auto, *">
            <TextBlock Grid.Column="0" Text="Základ:" VerticalAlignment="Center"/>
            <TextBox x:Name="DeathBox" Grid.Column="1" Margin="4,0"/>
            <Button Grid.Column="2" Content="✓" Margin="4,0"
                    Click="OnDeathConfirmed"/>
            <TextBlock x:Name="TotalDeathText" Grid.Column="3"
                       VerticalAlignment="Center" Text="Celkem: -"/>
        </Grid>

        <Separator/>

        <!-- Ability nemoci -->
        <TextBlock Text="Vlastnosti nemoci" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*, Auto, *">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Aktivní" FontSize="11"/>
                <ListBox x:Name="ActiveDiseaseAbilitiesBox" Height="120"
                         SelectionChanged="OnDiseaseAbilitySelectionChanged"
                         DoubleTapped="OnActiveDiseaseAbilityDoubleTapped"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↔" VerticalAlignment="Center" 
                    Margin="4,0" Click="OnMoveDiseaseAbilityClicked"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Dostupné" FontSize="11"/>
                <ListBox x:Name="AvailableDiseaseAbilitiesBox" Height="120"
                         SelectionChanged="OnDiseaseAbilitySelectionChanged"
                         DoubleTapped="OnAvailableDiseaseAbilityDoubleTapped"/>
            </StackPanel>
        </Grid>
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="4" Height="60">
            <TextBlock x:Name="DiseaseAbilityDescText" TextWrapping="Wrap" FontSize="11"/>
        </Border>

        <Separator/>

        <!-- Očkování -->
        <TextBlock Text="Nastavení vakcíny" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Účinnost proti přenosu (%):" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="VaccineProtectionBox" Grid.Row="1" Grid.Column="0" Margin="0,2,4,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Účinnost proti úmrtí (%):" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="VaccineDeathBox" Grid.Row="1" Grid.Column="1" Margin="4,2,0,0"/>
        </Grid>
        <Button Content="Použít" HorizontalAlignment="Right" Click="OnVaccineConfirmed"/>

        <Separator/>

        <!-- Denní výpis -->
        <TextBlock Text="Denní výpis" FontWeight="Bold"/>
        <ListBox x:Name="LogBox" Height="120"/>

        <Separator/>

        <!-- Rychlost dne -->
        <TextBlock Text="Rychlost simulace" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*, Auto">
            <TextBox x:Name="DaySpeedBox" Grid.Column="0" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Použít" Click="OnDaySpeedConfirmed"/>
        </Grid>

        <Separator/>

        <!-- Ukončit -->
        <Button Content="Ukončit simulaci" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnStopSimulationClicked"/>

    </StackPanel>
</ScrollViewer>
        </Border>
    </Grid>
</UserControl>